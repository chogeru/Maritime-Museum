  - "\u6BCE\u5E748\u6708\u9803\u306B\u306F\u3001\u3053\u306E\u661F\u5EA7\u3092\u4E2D\u5FC3\u306B\u300C\u30DA\u30EB\u30BB\u30A6\u30B9\u5EA7\u6D41\u661F\u7FA4\u300D\u304C\u591C\u7A7A\u3092\u5F69\u3063\u3066\u304F\u308C\u307E\u3059\u3002"
  - "\u6B21\u306B\u3054\u7D39\u4ECB\u3059\u308B\u306E\u306F\u3001\u96A3\u308A\u5408\u3046\u661F\u5EA7\u3001\u304E\u3087\u3057\u3083\u5EA7\u3067\u3059\u3002"
